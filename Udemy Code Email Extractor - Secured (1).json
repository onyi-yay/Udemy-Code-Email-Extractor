    {
      "parameters": {
        "jsCode": "// Get form data\nconst formName = $('Form Trigger').item.json['Full Name'];\nconst formCode = $('Form Trigger').item.json['Access Code'];\n\n// Get ALL users from sheet\nconst allUsers = $input.all();\n\nconsole.log('=== VALIDATION DEBUG ===');\nconsole.log('Form submitted:');\nconsole.log('  Name:', formName);\nconsole.log('  Code:', formCode);\nconsole.log('');\nconsole.log('Total users in sheet:', allUsers.length);\nconsole.log('');\n\n// Find matching user\nlet matchedUser = null;\n\nfor (const user of allUsers) {\n  const sheetName = user.json['Full Name'];\n  const sheetCode = user.json['Access Code'];\n  const codeUsed = user.json['Code Used'];\n  \n  // Clean and normalize\n  const cleanFormName = (formName || '').toLowerCase().trim();\n  const cleanSheetName = (sheetName || '').toLowerCase().trim();\n  const cleanFormCode = (formCode || '').trim().toUpperCase();\n  const cleanSheetCode = (sheetCode || '').trim().toUpperCase();\n  const cleanCodeUsed = (codeUsed || '').toLowerCase().trim();\n  \n  console.log('Checking user:', sheetName);\n  \n  // Check if this user matches ALL criteria\n  const nameMatch = cleanSheetName === cleanFormName;\n  const codeMatch = cleanSheetCode === cleanFormCode;\n  const notUsed = cleanCodeUsed === 'no';\n  \n  if (nameMatch && codeMatch && notUsed) {\n    console.log('  ✅ MATCH FOUND!');\n    matchedUser = user.json;\n    break;\n  } else {\n    if (nameMatch) console.log('  Name matches but...');\n    if (!codeMatch && nameMatch) console.log('    ❌ Code mismatch');\n    if (!notUsed && nameMatch) console.log('    ❌ Code already used');\n  }\n}\n\nconsole.log('');\n\nif (matchedUser) {\n  console.log('✅ VALIDATION PASSED');\n  return {\n    isValid: true,\n    fullName: matchedUser['Full Name'],\n    accessCode: matchedUser['Access Code'],\n    rowNumber: matchedUser['row_number']\n  };\n} else {\n  console.log('❌ VALIDATION FAILED');\n  return {\n    isValid: false,\n    reason: 'Invalid credentials or access code already used'\n  };\n}\n"
      },
