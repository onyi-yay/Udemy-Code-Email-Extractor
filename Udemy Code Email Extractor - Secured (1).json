      "parameters": {
        "jsCode": "// Extract the Udemy code from email body\nconst emailBody = $input.item.json.snippet || $input.item.json.plainText || $input.item.json.body || '';\n\nconsole.log('Searching for Udemy code...');\n\nconst codePattern = /(?:code|Code).*?([0-9]{6})(?!.*expires)/s;\nlet udemyCode = 'Code not found';\n\nconst match = emailBody.match(codePattern);\nif (match && match[1]) {\n  udemyCode = match[1];\n  console.log('✅ Found code:', udemyCode);\n}\n\n// Get validation data from previous nodes\nconst validationData = $('Validate User & Code').item.json;\n\nreturn {\n  userName: validationData.fullName,\n  accessCode: validationData.accessCode,\n  rowNumber: validationData.rowNumber,\n  udemyCode: udemyCode,\n  emailSubject: $input.item.json.subject\n};"
      },
